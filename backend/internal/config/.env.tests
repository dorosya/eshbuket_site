# Тестовое окружение
APP_ENV=test

#Рандомные данные для теста админки
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyzABCDEF1234567890abcde

# URL бекенда для тестов
